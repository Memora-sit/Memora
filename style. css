
/* =========================
   MEMORA - DESIGN PRINCIPAL
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --rose: #d8899b;
    --rose-dark: #a84f68;
    --rose-light: #fbe9ed;
    --cream: #fffaf5;
    --white: #ffffff;
    --text: #49373b;
    --muted: #89777b;
    --border: #f0dce1;
    --shadow: 0 8px 25px rgba(125, 65, 80, 0.09);
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--cream);
    color: var(--text);
    line-height: 1.6;
}

button,
input,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    text-decoration: none;
    color: inherit;
}

/* HEADER */

header {
    background: rgba(255, 255, 255, 0.97);
    padding: 18px 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--border);
    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.03);
}

.logo {
    font-size: 28px;
    font-weight: bold;
    color: var(--rose-dark);
    letter-spacing: 1px;
}

nav,
.nav-links {
    display: flex;
    align-items: center;
    gap: 25px;
}

nav a,
.nav-links a {
    font-size: 14px;
    font-weight: 600;
    transition: color 0.2s;
}

nav a:hover,
.nav-links a:hover {
    color: var(--rose-dark);
}

.menu-toggle {
    display: none;
    border: none;
    background: transparent;
    font-size: 27px;
    color: var(--rose-dark);
}

/* TITLES */

h1,
h2,
h3 {
    line-height: 1.3;
}

h1,
h2 {
    text-align: center;
}

h1 {
    font-size: clamp(28px, 4vw, 42px);
    color: var(--rose-dark);
    margin: 35px 15px 12px;
}

h2 {
    font-size: 29px;
    color: var(--rose-dark);
    margin-bottom: 25px;
}

p {
    color: var(--muted);
}

/* MAIN CONTENT */

main,
.products-section,
.product-section {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 25px 5%;
}

.page-intro {
    text-align: center;
    margin: 15px auto 35px;
    max-width: 700px;
}

.page-intro p {
    font-size: 16px;
}

/* CATEGORY BUTTONS */

.categories,
.category-buttons,
#categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 25px auto 35px;
}

.categories button,
.category-buttons button,
#categories button {
    border: 1px solid var(--rose);
    border-radius: 25px;
    background: var(--white);
    color: var(--rose-dark);
    padding: 10px 20px;
    transition: 0.2s;
}

.categories button:hover,
.category-buttons button:hover,
#categories button:hover,
.categories button.active,
.category-buttons button.active,
#categories button.active {
    background: var(--rose);
    color: white;
}

/* PRODUCTS GRID */

#product-grid,
.product-grid,
.products-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    align-items: stretch;
}

/* PRODUCT CARD */

.product-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 13px;
    overflow: hidden;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: transform 0.25s, box-shadow 0.25s;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(125, 65, 80, 0.15);
}

.product-card img {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
    object-position: center;
    border-radius: 11px;
    cursor: zoom-in;
    background: var(--rose-light);
}

.product-card h3 {
    color: var(--text);
    font-size: 17px;
    margin: 13px 0 5px;
}

.product-card p {
    font-size: 14px;
    margin: 4px 0;
}

.product-card .price {
    font-size: 19px;
    font-weight: bold;
    color: var(--rose-dark);
    margin: 7px 0;
}

/* COLOR SELECTOR */

.product-card label {
    font-size: 13px;
    color: var(--text);
}

.product-card select,
.product-card input[type="color"] {
    margin-top: 6px;
}

.product-card select {
    width: 100%;
    padding: 9px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--cream);
    color: var(--text);
}

/* BUTTONS */

.product-card button,
button.add-to-cart,
#cart-button,
.cart-button {
    border: none;
    border-radius: 9px;
    background: var(--rose);
    color: white;
    padding: 11px 14px;
    margin-top: 12px;
    font-weight: bold;
    transition: 0.2s;
}

.product-card button:hover,
button.add-to-cart:hover,
#cart-button:hover,
.cart-button:hover {
    background: var(--rose-dark);
}

/* CART */

#cart,
.cart-modal,
#cart-modal {
    background: white;
    border-radius: 16px;
    padding: 22px;
    box-shadow: var(--shadow);
}

.cart-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
}

.cart-item button {
    padding: 5px 10px;
    border: none;
    border-radius: 6px;
    background: var(--rose-light);
    color: var(--rose-dark);
}

#cart-total,
.cart-total {
    margin-top: 20px;
    text-align: right;
    font-size: 21px;
    font-weight: bold;
    color: var(--rose-dark);
}

/* IMAGE ZOOM */

#image-modal,
.image-modal,
#zoom-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(35, 20, 25, 0.85);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 25px;
}

#image-modal img,
.image-modal img,
#zoom-modal img {
    max-width: 90%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 12px;
}

#image-modal .close,
.image-modal .close,
#zoom-modal .close {
    position: absolute;
    top: 20px;
    right: 30px;
    color: white;
    font-size: 38px;
    border: none;
    background: transparent;
    cursor: pointer;
}

/* FORMS */

form {
    max-width: 650px;
    margin: 25px auto;
    padding: 25px;
    background: white;
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
}

form input,
form textarea,
form select {
    display: block;
    width: 100%;
    padding: 12px;
    margin: 10px 0 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--cream);
}

form textarea {
    min-height: 120px;
    resize: vertical;
}

form button {
    width: 100%;
    border: none;
    border-radius: 9px;
    padding: 13px;
    background: var(--rose);
    color: white;
    font-weight: bold;
}

/* FOOTER */

footer {
    margin-top: 45px;
    padding: 25px 15px;
    text-align: center;
    background: var(--rose-light);
    color: var(--rose-dark);
}

/* TABLET */

@media (max-width: 1000px) {
    #product-grid,
    .product-grid,
    .products-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .product-card img {
        height: 190px;
    }
}

/* MOBILE */

@media (max-width: 650px) {
    header {
        padding: 15px 5%;
        flex-wrap: wrap;
    }

    .logo {
        font-size: 24px;
    }

    .menu-toggle {
        display: block;
    }

    nav,
    .nav-links {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    nav.open,
    .nav-links.open {
        display: flex;
    }

    main,
    .products-section,
    .product-section {
        padding: 15px 4%;
    }

    h1 {
        font-size: 28px;
    }

    h2 {
        font-size: 24px;
    }

    #product-grid,
    .product-grid,
    .products-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .product-card {
        padding: 9px;
        border-radius: 12px;
    }

    .product-card img {
        height: 155px;
    }

    .product-card h3 {
        font-size: 15px;
    }

    .product-card .price {
        font-size: 17px;
    }

    .product-card button {
        font-size: 12px;
        padding: 10px 7px;
    }

    .categories button,
    .category-buttons button,
    #categories button {
        padding: 8px 12px;
        font-size: 13px;
    }
}
